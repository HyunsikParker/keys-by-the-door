  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">KeysByTheDoorController – reminder state, demo clock, door logic</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - "// @input SceneObject cameraObject {\"hint\":\"Main camera SceneObject; its world position is the user's position\"}"
    - '// @input SceneObject frontDoor {"hint":"Front door SceneObject; its local +Z faces into the hallway (toward the user)"}'
    - '// @input AssignableType_1 reminderCard {"hint":"Car-keys reminder card view (KeysReminderCard)"}'
    - '// @input AssignableType_2 clockPanel {"hint":"Demo clock view in the living room"}'
    - '// @input AssignableType_3 directionArrow {"hint":"Out-of-view hint arrow (DirectionArrow)"}'
    - '// @input Asset.AudioTrackAsset chimeTrack {"hint":"Soft chime played when the reminder appears out of view (optional)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input string commuteTime = "08:00" {"hint":"Commute time, HH:MM (24 h). The reminder shows when the demo clock reaches it."}'
    - '// @input float clockLeadSeconds = 60 {"hint":"Demo clock starts this many seconds before the commute time", "widget":"slider", "min":0, "max":600, "step":1}'
    - '// @input float clockSpeed = 1 {"hint":"Demo clock speed (1 = real time)", "widget":"slider", "min":0.1, "max":20, "step":0.1}'
    - '// @input float approachDistanceCm = 220 {"hint":"Heading for the door = closer than this to the door plane (cm, measured along the hallway)", "widget":"slider", "min":50, "max":300, "step":5}'
    - '// @input float passMarginCm = 10 {"hint":"Left for work = this far past the door plane (cm)", "widget":"slider", "min":0, "max":60, "step":1}'
    - '// @input float outOfViewAngleDeg = 25 {"hint":"Card counts as out of view when it is more than this many degrees off the view direction", "widget":"slider", "min":10, "max":60, "step":1}'
    - '// @input float bounceHeightCm = 4 {"hint":"Bounce height of the card (cm)", "widget":"slider", "min":0.5, "max":10, "step":0.5}'
    - '// @input float bounceHz = 2 {"hint":"Bounces per second", "widget":"slider", "min":0.5, "max":5, "step":0.1}'
    - '// @input float chimeVolume = 0.6 {"hint":"Chime volume", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Debug</span>"}'
    - '// @ui {"widget":"group_start", "label":"Debug"}'
    - '// @input bool debugLogs = true {"hint":"Print state changes to the log"}'
    - '// @ui {"widget":"group_end"}'
